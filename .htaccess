Options -Indexes

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files and private application directories.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/|$) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.[^/]+|README\.md)$ - [F,L,NC]

    # Let Laravel's public .htaccess handle internally rewritten requests.
    RewriteRule ^public(/|$) - [L]

    # Serve the application and assets exclusively from public.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
